<!DOCTYPE html>
<html>
<head>
    <title> Product form </title>
</head>

<body>
    <div class="form-conatiner">
        <form method="POST" class="pure-form">
            <h2>Product Form</h2>
            {{ form.csrf_token }} <!-- sau hiddent_tag() -->
            <!-- in loc de div pt a grupa in grid folosim fieldset -->
            <fieldset>
                <legend>Va rugam introduceti datele produsului</legend>
                <!--
                <input type="text" placeholder="Name" maxlength="100" required />
                <input type="number" step="0.01" min="0" name="product price" placeholder="Price" required/>
                <input type="text" name="product brand" placeholder="Brand" maxlength="100" required />
                <input type="number" placeholder="Quantity" required/>
                -->
                <!-- folosim campurile din flaks wtf forms nu mai definim noi aici -->
                <!-- putem sa nu punem .label ca arata urat, 
                https://stackoverflow.com/questions/9749742/wtforms-can-i-add-a-placeholder-attribute-when-i-init-a-field
                -->
                <!-- WTF Forms genereaza singur atributul name tu nu il mai pui ca altfel suprascrii -->
                {{ form.product_name(placeholder="Name", maxlength="100", required=True) }}
                {% if form.product_name.errors %}
                <ul class="errors">
                    {% for error in form.product_name.errors %}
                    <li>{{ error }}</li>
                    {% endfor %}
                </ul>
                {% endif %}

                {{ form.product_code(placeholder="Product code", maxlength="64", required=True) }}
                {% if form.product_code.errors %}
                <ul class="errors">
                    {% for error in form.product_code.errors %}
                    <li>{{ error }}</li>
                    {% endfor %}
                </ul>
                {% endif %}

                {{ form.product_price(step="0.01", min="0", placeholder="Price", required=True) }}
                {% if form.product_price.errors %}
                <ul class="errors">
                    {% for error in form.product_price.errors %}
                    <li>{{ error }}</li>
                    {% endfor %}
                </ul>
                {% endif %}

                {{ form.product_brand(placeholder="Brand", maxlength="64", required=True) }}
                {% if form.product_brand.errors %}
                <ul class="errors">
                    {% for error in form.product_brand.errors %}
                    <li>{{ error }}</li>
                    {% endfor %}
                </ul>
                {% endif %}

                {{ form.product_quantity(placeholder="Quantity", required=True) }}
                {% if form.product_quantity.errors %}
                <ul class="errors">
                    {% for error in form.product_quantity.errors %}
                    <li>{{ error }}</li>
                    {% endfor %}
                </ul>
                {% endif %}
                <button type="submit" class="pure-button pure-button-primary">Submit</button>
            </fieldset>
        </form>
    </div>
</body>

</html>